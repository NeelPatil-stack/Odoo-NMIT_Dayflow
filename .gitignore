# ==============================
# KaaryaSetu / Dayflow HRMS
# Root .gitignore
# ==============================

# Dependencies
node_modules/
.npm

# Environment files (NEVER commit!)
.env
.env.local
.env.development
.env.production
backend/.env
frontend/.env

# Build outputs
dist/
build/
.vite/

# Uploads (user-uploaded files)
backend/uploads/
!backend/uploads/.gitkeep

# IDE / Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
logs/

# Testing
coverage/
.nyc_output/

# Misc
*.bak
*.tmp
*.cache
